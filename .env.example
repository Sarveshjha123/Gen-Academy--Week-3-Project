# 1) Copy this file and name the copy exactly:  .env      2) Fill in your keys.  NEVER share or upload .env

# --- Nebius (the AI models) ---
NEBIUS_API_KEY=paste-your-nebius-key-here
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/
# the supervisor
CHAT_MODEL=openai/gpt-oss-120b
# sub-agents; empty = same as CHAT_MODEL (try openai/gpt-oss-20b for speed)
HELPER_MODEL=
# evals; ideally a DIFFERENT model from CHAT_MODEL
JUDGE_MODEL=
REASONING_EFFORT=low

# --- Pinecone (contract + policy search) ---
PINECONE_API_KEY=paste-your-pinecone-key-here
# if your free plan has no room for a new index, reuse cloudpaw-renewals
PINECONE_INDEX=northfield-procurement

# --- Tavily (web news) ---
TAVILY_API_KEY=paste-your-tavily-key-here

# --- Mem0 (long-term memory). Empty = a local file is used instead ---
MEM0_API_KEY=paste-your-mem0-key-here

# --- LangSmith (traces of every run) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=paste-your-langsmith-key-here
LANGSMITH_PROJECT=northfield-procurement

# --- Settings ---
TODAY=2026-10-26
# false = skip MCP and call the same functions directly (fallback)
USE_MCP=true
MAX_AGENT_STEPS=60
